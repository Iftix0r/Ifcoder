<resources>
    <!--
      Ataylab "Light" (DayNight emas): colors.xml'da faqat bitta (och) palitra bor,
      qorong'i rejim uchun alohida ranglar yo'q. DayNight bilan telefon qorong'i
      rejimda bo'lsa, matn rangi tizim standarti bo'yicha oqarib ketadi va oq fon
      ustida ko'rinmay qoladi (aynan shu bug tufayli login ekranida yozuv ko'rinmadi).
    -->
    <style name="Theme.IfcoderOperator" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:editTextColor">@color/text_primary</item>
    </style>

    <style name="DetailLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="DetailValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
